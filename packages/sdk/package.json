{
  "name": "@kinetic-ledger/sdk",
  "version": "1.0.0",
  "description": "Kinetic Ledger SDK for Arc blockchain interactions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./usdc": {
      "import": "./dist/usdc.mjs",
      "require": "./dist/usdc.js",
      "types": "./dist/usdc.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/usdc.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/usdc.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arc",
    "usdc",
    "blockchain",
    "ethereum",
    "web3",
    "kinetic-ledger"
  ],
  "author": "Kinetic Ledger Team",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  }
}
